FROM node:16-bullseye
WORKDIR /app
COPY ./backend/package*.json ./
RUN npm install
RUN rm -rf /var/lib/apt/lists/* \
 && apt-get clean \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates wget gnupg \
 && wget -qO /usr/share/keyrings/mongodb-server-7.0.gpg \
      https://www.mongodb.org/static/pgp/server-7.0.asc \
 && echo "deb [ arch=amd64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/debian bullseye/mongodb-org/7.0 main" \
      > /etc/apt/sources.list.d/mongodb-org-7.0.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends mongodb-mongosh \
 && rm -rf /var/lib/apt/lists/*
COPY ./backend . 
RUN mkdir ./output
RUN mkdir ./input
COPY ./backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
RUN date > /app/date.txt
#RUN sed -i 's/localhost/host.docker.internal/g' /app/config.js
CMD ["node", "mapper"]